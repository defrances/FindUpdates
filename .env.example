FINDUPDATES_ENVIRONMENT=local
FINDUPDATES_LOG_LEVEL=INFO
FINDUPDATES_HTTP_TIMEOUT_SECONDS=30
FINDUPDATES_HTTP_MAX_RETRIES=3
FINDUPDATES_HTTP_MIN_INTERVAL_SECONDS=0.25
FINDUPDATES_MSRC_BASE_URL=https://api.msrc.microsoft.com/cvrf/v3.0
FINDUPDATES_MSRC_LOOKBACK_DAYS=45
# Optional machine-readable Intel CSAF index. Leave empty for fixture-only local runs.
FINDUPDATES_INTEL_CSAF_INDEX_URL=
FINDUPDATES_INTEL_LOOKBACK_DAYS=120
FINDUPDATES_NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
FINDUPDATES_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
FINDUPDATES_ENRICHMENT_CACHE_MAX_AGE_HOURS=24
# Optional NVD API key. Never commit a real key; load it from a secret store.
FINDUPDATES_NVD_API_KEY=
# Collector polling checkpoints. Directory is local runtime state, not a secret store.
FINDUPDATES_CHECKPOINT_DIR=.findupdates/checkpoints
# Optional advisory JSON output directory for a poll run.
FINDUPDATES_COLLECTION_OUTPUT_DIR=
# Bounded analysis agents. Leave disabled unless a reviewed provider is configured.
# Model credentials must not be committed; they are not part of Settings.
FINDUPDATES_AI_ENABLED=false
FINDUPDATES_AI_PROVIDER=offline
# Optional notification webhook. Never commit a real URL that embeds a token.
FINDUPDATES_NOTIFICATION_WEBHOOK_URL=
# Deployment adapters receive short-lived OIDC tokens at execution time.
# Never commit tenant secrets, refresh tokens or device credentials.
# Never place production credentials or patient data in this file.
