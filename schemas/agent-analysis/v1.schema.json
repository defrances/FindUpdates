{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findupdates.local/schemas/agent-analysis/v1.schema.json",
  "title": "AgentAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "advisory_id",
    "device_id",
    "model",
    "prompt_version",
    "template_version",
    "used_fallback",
    "provider_available",
    "needs_human_review",
    "confidence",
    "validation_errors",
    "authoritative",
    "claims",
    "sections",
    "rejected_actions",
    "input_fingerprint",
    "generated_at"
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1}
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis_id": {"$ref": "#/$defs/nonEmptyString"},
    "advisory_id": {"$ref": "#/$defs/nonEmptyString"},
    "device_id": {"$ref": "#/$defs/nonEmptyString"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "version"],
      "properties": {
        "provider": {"$ref": "#/$defs/nonEmptyString"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "version": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "prompt_version": {"$ref": "#/$defs/nonEmptyString"},
    "template_version": {"$ref": "#/$defs/nonEmptyString"},
    "used_fallback": {"type": "boolean"},
    "provider_available": {"type": "boolean"},
    "needs_human_review": {"type": "boolean"},
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high", "unknown"]
    },
    "validation_errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "authoritative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_id",
        "device_id",
        "applicability_verdict",
        "applicability_confidence",
        "risk_score",
        "risk_severity",
        "policy_result",
        "reason_codes"
      ],
      "properties": {
        "advisory_id": {"$ref": "#/$defs/nonEmptyString"},
        "device_id": {"$ref": "#/$defs/nonEmptyString"},
        "applicability_verdict": {"$ref": "#/$defs/nonEmptyString"},
        "applicability_confidence": {"$ref": "#/$defs/nonEmptyString"},
        "risk_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "risk_severity": {"$ref": "#/$defs/nonEmptyString"},
        "policy_result": {"$ref": "#/$defs/nonEmptyString"},
        "reason_codes": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "kind", "text", "evidence_ids"],
        "properties": {
          "claim_id": {"$ref": "#/$defs/nonEmptyString"},
          "kind": {"type": "string", "enum": ["fact", "inference"]},
          "text": {"$ref": "#/$defs/nonEmptyString"},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/nonEmptyString"}
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "summary", "claim_ids", "needs_human_review"],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "update_intelligence",
              "applicability_review",
              "risk_explanation",
              "change_planning"
            ]
          },
          "summary": {"$ref": "#/$defs/nonEmptyString"},
          "claim_ids": {
            "type": "array",
            "items": {"$ref": "#/$defs/nonEmptyString"}
          },
          "needs_human_review": {"type": "boolean"}
        }
      }
    },
    "rejected_actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "input_fingerprint": {"$ref": "#/$defs/nonEmptyString"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
