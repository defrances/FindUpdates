{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findupdates.local/schemas/deployment-result/v1.schema.json",
  "title": "DeploymentResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "idempotency_key",
    "status",
    "dry_run",
    "backend",
    "target_device_ids",
    "package_id",
    "package_sha256",
    "duplicate",
    "error_code",
    "audit",
    "updated_at"
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1}
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "deployment_id": {"$ref": "#/$defs/nonEmptyString"},
    "idempotency_key": {"$ref": "#/$defs/nonEmptyString"},
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "paused",
        "succeeded",
        "failed",
        "cancelled",
        "rolled_back",
        "rejected"
      ]
    },
    "dry_run": {"type": "boolean"},
    "backend": {"$ref": "#/$defs/nonEmptyString"},
    "target_device_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "package_id": {"$ref": "#/$defs/nonEmptyString"},
    "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "duplicate": {"type": "boolean"},
    "error_code": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "string",
          "enum": [
            "auth",
            "target_mismatch",
            "package_mismatch",
            "backend_rejected",
            "timeout",
            "partial_failure",
            "authorization_missing",
            "firmware_not_oem_qualified",
            "rollback_unsupported",
            "unsupported_update_kind"
          ]
        }
      ]
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approver",
        "risk_assessment_id",
        "validation_result_id",
        "change_idempotency_key",
        "backend_operation",
        "credential_kind"
      ],
      "properties": {
        "approver": {"$ref": "#/$defs/nonEmptyString"},
        "risk_assessment_id": {"$ref": "#/$defs/nonEmptyString"},
        "validation_result_id": {"$ref": "#/$defs/nonEmptyString"},
        "change_idempotency_key": {"$ref": "#/$defs/nonEmptyString"},
        "backend_operation": {"$ref": "#/$defs/nonEmptyString"},
        "credential_kind": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
