{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findupdates.local/schemas/update-advisory/v1.schema.json",
  "title": "UpdateAdvisory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "advisory_id",
    "vendor",
    "source",
    "vendor_advisory_id",
    "title",
    "description",
    "published_at",
    "revised_at",
    "collected_at",
    "parser_version",
    "cve_ids",
    "package_ids",
    "references",
    "vendor_severity",
    "cvss",
    "update_category",
    "reboot_requirement",
    "known_exploited",
    "exploitability",
    "affected_products",
    "remediations",
    "prerequisites",
    "supersedes",
    "superseded_by",
    "known_issues",
    "vendor_recommendation",
    "completeness",
    "incomplete_fields",
    "normalization_confidence",
    "conflicts",
    "field_provenance",
    "provenance"
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "nullableString": {"type": ["string", "null"], "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cveId": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"},
    "triState": {"type": "string", "enum": ["true", "false", "unknown"]},
    "confidence": {"type": "string", "enum": ["high", "medium", "low", "unknown"]},
    "productStatus": {
      "type": "string",
      "enum": ["affected", "not_affected", "fixed", "unknown"]
    },
    "cvssRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "vector", "base_score", "source"],
      "properties": {
        "version": {"type": "string", "enum": ["2.0", "3.0", "3.1", "4.0", "unknown"]},
        "vector": {"$ref": "#/$defs/nullableString"},
        "base_score": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "source": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "packageId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["kb", "driver", "firmware", "bios", "microcode", "other", "unknown"]
        },
        "value": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "affectedProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor",
        "product",
        "version_range",
        "builds",
        "architectures",
        "vendor_product_id",
        "cpe",
        "status"
      ],
      "properties": {
        "vendor": {"$ref": "#/$defs/nonEmptyString"},
        "product": {"$ref": "#/$defs/nonEmptyString"},
        "version_range": {"$ref": "#/$defs/nullableString"},
        "builds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "architectures": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["x64", "x86", "arm64", "other", "unknown"]}
        },
        "vendor_product_id": {"$ref": "#/$defs/nullableString"},
        "cpe": {"$ref": "#/$defs/nullableString"},
        "status": {"$ref": "#/$defs/productStatus"}
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "fixed_version", "package_id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["vendor_fix", "workaround", "mitigation", "unavailable", "unknown"]
        },
        "description": {"$ref": "#/$defs/nullableString"},
        "fixed_version": {"$ref": "#/$defs/nullableString"},
        "package_id": {
          "oneOf": [
            {"$ref": "#/$defs/packageId"},
            {"type": "null"}
          ]
        }
      }
    },
    "fieldProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "source"],
      "properties": {
        "field_path": {"$ref": "#/$defs/nonEmptyString"},
        "source": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "reason"],
      "properties": {
        "field_path": {"$ref": "#/$defs/nonEmptyString"},
        "reason": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "raw_sha256", "retrieved_at", "content_type"],
      "properties": {
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "content_type": {"$ref": "#/$defs/nullableString"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "advisory_id": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "Stable internal identity. Derived from vendor + vendor advisory ID, else CVE set, else raw hash."
    },
    "vendor": {"type": "string", "enum": ["microsoft", "intel", "other"]},
    "source": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "Collector/source name such as msrc or intel-csaf."
    },
    "vendor_advisory_id": {"$ref": "#/$defs/nullableString"},
    "title": {"$ref": "#/$defs/nonEmptyString"},
    "description": {"$ref": "#/$defs/nullableString"},
    "published_at": {"type": "string", "format": "date-time"},
    "revised_at": {"type": ["string", "null"], "format": "date-time"},
    "collected_at": {"type": "string", "format": "date-time"},
    "parser_version": {"$ref": "#/$defs/nonEmptyString"},
    "cve_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/cveId"}
    },
    "package_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/packageId"}
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri"}
    },
    "vendor_severity": {
      "type": "string",
      "enum": ["none", "low", "medium", "high", "critical", "unknown"]
    },
    "cvss": {
      "type": "array",
      "items": {"$ref": "#/$defs/cvssRecord"}
    },
    "update_category": {
      "type": "string",
      "enum": ["os", "driver", "firmware", "bios", "microcode", "application", "advisory", "other", "unknown"]
    },
    "reboot_requirement": {
      "type": "string",
      "enum": ["required", "maybe", "no", "unknown"]
    },
    "known_exploited": {
      "$ref": "#/$defs/triState",
      "description": "Must stay tri-state. Absence of exploitation evidence is unknown, never false."
    },
    "exploitability": {
      "type": "string",
      "enum": ["none", "low", "high", "unknown"]
    },
    "affected_products": {
      "type": "array",
      "items": {"$ref": "#/$defs/affectedProduct"}
    },
    "remediations": {
      "type": "array",
      "items": {"$ref": "#/$defs/remediation"}
    },
    "prerequisites": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "supersedes": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "superseded_by": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "known_issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "vendor_recommendation": {"$ref": "#/$defs/nullableString"},
    "completeness": {
      "type": "string",
      "enum": ["complete", "partial", "unknown"]
    },
    "incomplete_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "normalization_confidence": {"$ref": "#/$defs/confidence"},
    "conflicts": {
      "type": "array",
      "items": {"$ref": "#/$defs/conflict"}
    },
    "field_provenance": {
      "type": "array",
      "items": {"$ref": "#/$defs/fieldProvenance"}
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  }
}
