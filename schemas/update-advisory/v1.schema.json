{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findupdates.local/schemas/update-advisory/v1.schema.json",
  "title": "UpdateAdvisory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "advisory_id", "vendor", "source", "title", "published_at", "raw_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "advisory_id": {"type": "string", "minLength": 1},
    "vendor": {"type": "string", "enum": ["microsoft", "intel", "other"]},
    "source": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "format": "date-time"},
    "revised_at": {"type": ["string", "null"], "format": "date-time"},
    "cve_ids": {"type": "array", "items": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"}, "uniqueItems": true},
    "references": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "raw_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
