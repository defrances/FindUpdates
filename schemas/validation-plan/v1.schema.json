{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findupdates.local/schemas/validation-plan/v1.schema.json",
  "title": "ValidationPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "device_model",
    "baseline_id",
    "cases"
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1}
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"$ref": "#/$defs/nonEmptyString"},
    "profile_version": {"$ref": "#/$defs/nonEmptyString"},
    "device_model": {"$ref": "#/$defs/nonEmptyString"},
    "baseline_id": {"$ref": "#/$defs/nonEmptyString"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "domain",
          "title",
          "mandatory",
          "automatable",
          "clinical",
          "timeout_seconds"
        ],
        "properties": {
          "case_id": {"$ref": "#/$defs/nonEmptyString"},
          "domain": {
            "type": "string",
            "enum": [
              "boot",
              "os_health",
              "driver_firmware",
              "medical_application",
              "connectivity",
              "resources",
              "critical_service",
              "device_io",
              "rollback",
              "known_issue"
            ]
          },
          "title": {"$ref": "#/$defs/nonEmptyString"},
          "mandatory": {"type": "boolean"},
          "automatable": {"type": "boolean"},
          "clinical": {"type": "boolean"},
          "timeout_seconds": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
