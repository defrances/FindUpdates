{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findupdates.local/schemas/validation-result/v1.schema.json",
  "title": "ValidationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "profile_id",
    "profile_version",
    "device_model",
    "baseline_id",
    "overall",
    "blocks_promotion",
    "baseline",
    "after",
    "cases",
    "artifacts",
    "generated_at"
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os_version", "app_version", "driver_version", "firmware_version"],
      "properties": {
        "os_version": {"$ref": "#/$defs/nonEmptyString"},
        "app_version": {"$ref": "#/$defs/nonEmptyString"},
        "driver_version": {"$ref": "#/$defs/nonEmptyString"},
        "firmware_version": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "result_id": {"$ref": "#/$defs/nonEmptyString"},
    "profile_id": {"$ref": "#/$defs/nonEmptyString"},
    "profile_version": {"$ref": "#/$defs/nonEmptyString"},
    "device_model": {"$ref": "#/$defs/nonEmptyString"},
    "baseline_id": {"$ref": "#/$defs/nonEmptyString"},
    "overall": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"]
    },
    "blocks_promotion": {"type": "boolean"},
    "baseline": {"$ref": "#/$defs/snapshot"},
    "after": {"$ref": "#/$defs/snapshot"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "domain",
          "mandatory",
          "clinical",
          "automatable",
          "outcome",
          "detail",
          "log_sha256"
        ],
        "properties": {
          "case_id": {"$ref": "#/$defs/nonEmptyString"},
          "domain": {"$ref": "#/$defs/nonEmptyString"},
          "mandatory": {"type": "boolean"},
          "clinical": {"type": "boolean"},
          "automatable": {"type": "boolean"},
          "outcome": {
            "type": "string",
            "enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"]
          },
          "detail": {"$ref": "#/$defs/nonEmptyString"},
          "log_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": {"$ref": "#/$defs/nonEmptyString"},
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
